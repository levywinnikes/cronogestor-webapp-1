# PostgreSQL (Neon ou outro provedor)
# Use sslmode=verify-full em produção para validação explícita do certificado do servidor.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=verify-full"

# Opcional para operações administrativas (migrations/introspection)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=verify-full"

# Seed opcional de admin local
SEED_ADMIN_EMAIL="admin@cronogestor.local"
SEED_ADMIN_NAME="Administrador"
# Gere um hash bcrypt e preencha aqui para criar o admin no seed
SEED_ADMIN_PASSWORD_HASH=""
